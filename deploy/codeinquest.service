[Unit]
Description=CodeInQuest (Next.js)
After=network.target postgresql.service

[Service]
Type=simple
User=codeinquest
WorkingDirectory=/opt/codeinquest
EnvironmentFile=/opt/codeinquest/.env
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
